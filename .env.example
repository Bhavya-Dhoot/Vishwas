# Optional. Leave blank to use the working clinic-template demo.
# Never paste real keys into Git or patient-facing pages.
OPENAI_API_KEY=
OPENAI_MODEL=

# Local synthetic-data prototype; keep the default loopback binding.
PORT=3000
APP_MODE=demo
# New encrypted database. The former data/vishwas.sqlite is deliberately not migrated.
DB_PATH=data/vishwas-demo-encrypted.sqlite
# Demo mode generates a key under the user's LOCALAPPDATA/Vishwas directory.
# For protected local evaluation, set APP_MODE=protected, choose a separate DB_PATH,
# set a 12+ character STAFF_PASSWORD and a random 64-character hex STATE_KEY.
# Keep both secrets outside the repository and back up the key separately.
STAFF_PASSWORD=
STATE_KEY=
# Prefer named local staff accounts in protected mode. Generate verifiers with
# scripts/create-staff-account.mjs and keep the JSON file outside the repository.
# When provided, STAFF_ACCOUNTS_FILE replaces the shared STAFF_PASSWORD login.
STAFF_ACCOUNTS_FILE=

# Local edge evaluation: block non-loopback hospital/Fabric adapters and cloud AI.
# Core workflow and reminders stay on this host. No offline patient-browser cache.
EDGE_ONLY=false

# Optional Fabric bridge. Only explicitly consented salted document commitments leave the app.
# Files, names, patient IDs, content hashes and salts remain encrypted off-chain.
FABRIC_GATEWAY_URL=http://127.0.0.1:3101
FABRIC_GATEWAY_TOKEN=

# Optional hospital directory/reservation contract; use the synthetic sample adapter only.
HOSPITAL_API_URL=
HOSPITAL_API_TOKEN=
